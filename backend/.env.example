APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
FRONTEND_ORIGIN=http://localhost:3000
LOG_LEVEL=INFO

CHROMA_PERSIST_DIRECTORY=./data/chroma
CHROMA_COLLECTION_NAME=rag_documents
CHROMA_BATCH_SIZE=256

EMBEDDING_MODEL_NAME=BAAI/bge-m3
EMBEDDING_DEVICE=auto
EMBEDDING_BATCH_SIZE=4
EMBEDDING_MAX_SEQ_LENGTH=1024
EMBEDDING_NORMALIZE=true
EMBEDDING_QUERY_PREFIX=auto
EMBEDDING_PASSAGE_PREFIX=auto
EMBEDDING_TRUST_REMOTE_CODE=false
TOKENIZER_MODEL_NAME=

CHUNK_SIZE=700
CHUNK_OVERLAP=100

TOP_K=5
MAX_UPLOAD_SIZE_MB=20
MAX_FILES_PER_REQUEST=5
ALLOW_DUPLICATE_DOCUMENTS=false
LANGUAGE_DETECTION_ENABLED=true

DATA_DIRECTORY=./data
DOCUMENT_REGISTRY_PATH=./data/document_registry.sqlite3

# --- Phase 3: query language detection ---
QUERY_LANGUAGE_MIN_CHARS=3
QUERY_LANGUAGE_MIN_CONFIDENCE=0.5
QUERY_LANGUAGE_MIN_MARGIN=0.15
# Optional ISO code used only when detection is not reliable. Empty = report "unknown".
QUERY_LANGUAGE_FALLBACK=

# --- Phase 3: RAG pipeline ---
RAG_MAX_QUESTION_LENGTH=2000
RAG_MIN_EVIDENCE_CHUNKS=1
RAG_DISTANCE_FILTER_ENABLED=true
# Lower cosine distance = more similar. Tune per embedding model. Empty filter = accept any.
RAG_MAX_DISTANCE=0.75
# If false, the LLM is NOT called when no chunk passes the retrieval policy.
RAG_GENERATION_WITHOUT_EVIDENCE=false

# --- Phase 3: generative LLM ---
# Groq, OpenAI, OpenRouter, Together use the OpenAI-compatible API.
# Use LLM_PROVIDER=mock for a network-free deterministic answer (tests/dev only).
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
# Never commit a real key. Put it in backend/.env (git-ignored).
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_TEMPERATURE=0
LLM_TIMEOUT_SECONDS=60
LLM_MAX_OUTPUT_TOKENS=800

# --- Phase 4A: claim-level verification ---
VERIFICATION_ENABLED=true
# Claim extraction is deterministic and local (no LLM or pretrained extractor).
# It is hard-capped at 30 claims regardless of this setting.
VERIFICATION_MAX_EXTRACTED_CLAIMS=30
VERIFICATION_MAX_CLAIMS=20
VERIFICATION_MAX_EVIDENCE_PER_CLAIM=50
# Hard ceiling for exhaustive claim/evidence NLI pairs. Pairs beyond it are
# returned as missing rather than silently dropped.
VERIFICATION_MAX_NLI_PAIRS=250
# Minimum claim-term or semantic relevance before an NLI verdict counts.
VERIFICATION_MIN_EVIDENCE_RELEVANCE=0.5
# Primary focused window; ambiguous claims may expand to the model limit.
VERIFICATION_PRIMARY_WINDOW_TOKENS=256
# Stop starting new NLI work after this many seconds; unstarted claims retain
# verification_error with the deadline reason instead of hanging the request.
VERIFICATION_DEADLINE_SECONDS=120
# Bounded admission control: one verification job at a time, 5s queue wait,
# and at most two waiting requests before returning overload.
VERIFICATION_MAX_CONCURRENT_REQUESTS=1
VERIFICATION_QUEUE_WAIT_SECONDS=5
VERIFICATION_MAX_QUEUED_REQUESTS=2
# Multilingual NLI; mDeBERTa is accurate but slower on CPU than compact models.
VERIFICATION_NLI_MODEL_NAME=MoritzLaurer/mDeBERTa-v3-base-mnli-xnli
# local = in-process PyTorch. onnx = exported ONNX Runtime model.
# hf_endpoint = hosted Hugging Face Inference Endpoint.
# The hosted endpoint must use the Text Classification task and accept
# {"text": premise, "text_pair": hypothesis}; serverless zero-shot is not
# equivalent because it treats candidate labels as hypotheses.
VERIFICATION_NLI_BACKEND=local
VERIFICATION_NLI_DEVICE=auto
# Local in-process inference batch size.
VERIFICATION_NLI_BATCH_SIZE=8
# Cap padded tokens per local batch to keep CPU/GPU memory bounded.
VERIFICATION_NLI_MAX_BATCH_TOKENS=8192
# 0 lets PyTorch choose; set a small value to limit CPU contention.
VERIFICATION_NLI_NUM_THREADS=0
# Exact claim-evidence prediction cache entries (0 disables the cache).
VERIFICATION_NLI_CACHE_SIZE=256
# ONNX backend: required model path, execution provider, and thread counts.
# Export with: python scripts/export_nli_onnx.py
VERIFICATION_NLI_ONNX_MODEL_PATH=
VERIFICATION_NLI_ONNX_PROVIDER=CPUExecutionProvider
VERIFICATION_NLI_ONNX_INTRA_THREADS=0
VERIFICATION_NLI_ONNX_INTER_THREADS=1
# Hosted endpoint defaults to one pair per request; increase only after
# confirming the deployed endpoint accepts batched text-pair inputs.
VERIFICATION_NLI_HOSTED_BATCH_SIZE=1
# Bounded concurrent hosted requests when there are multiple batches.
VERIFICATION_NLI_MAX_CONCURRENCY=2
VERIFICATION_NLI_MAX_TOKENS=256
# Required only when VERIFICATION_NLI_BACKEND=hf_endpoint.
VERIFICATION_NLI_ENDPOINT_URL=
VERIFICATION_NLI_API_KEY=
VERIFICATION_NLI_TIMEOUT_SECONDS=30
VERIFICATION_NLI_MAX_RETRIES=2
VERIFICATION_NLI_RETRY_BACKOFF_SECONDS=0.5

# Backend-only Hugging Face User Access Token (Inference Providers permission).
# Never expose this value to the frontend or commit it.
HF_TOKEN=

VERIFICATION_NLI_ENTAILMENT_THRESHOLD=0.5
# Raised to 0.6 because an unrelated passage scored 0.5025 contradiction.
VERIFICATION_NLI_CONTRADICTION_THRESHOLD=0.6
VERIFICATION_NER_ENABLED=true
VERIFICATION_NER_MODEL_NAME=Davlan/xlm-roberta-base-wikiann-ner
VERIFICATION_NER_DEVICE=auto
VERIFICATION_NER_MAX_TOKENS=512


# --- Hallucination Checks (separate from NLI) ---
# Local binary groundedness model. Input order: evidence/source first, claim second.
HALLUCINATION_ENABLED=true
HALLUCINATION_MODEL_NAME=Horizon-Labs/hallucination-guard-base
HALLUCINATION_MODEL_DEVICE=auto
# Set true after pre-downloading the checkpoint for strictly offline inference.
HALLUCINATION_MODEL_LOCAL_FILES_ONLY=false
HALLUCINATION_MODEL_MAX_TOKENS=2048
HALLUCINATION_MODEL_BATCH_SIZE=8
# Only needed if the checkpoint exposes generic LABEL_0/LABEL_1 labels.
HALLUCINATION_SUPPORTED_LABEL_INDEX=
HALLUCINATION_SUPPORT_THRESHOLD=0.5
HALLUCINATION_REVIEW_MARGIN=0.05
HALLUCINATION_MAX_CLAIMS=64
HALLUCINATION_MAX_EVIDENCE_PER_CLAIM=5
HALLUCINATION_MAX_EVIDENCE_CHARS=4000
HALLUCINATION_MAX_PAIRS=500
HALLUCINATION_DEADLINE_SECONDS=120
HALLUCINATION_CACHE_SIZE=32

# --- Hallucination Repair (evidence-grounded, iterative) ---
# Reuses stored Ask results, existing NLI, and Hallucination Guard only.
REPAIR_ENABLED=true
REPAIR_MAX_EVIDENCE_PER_CLAIM=3
REPAIR_DEADLINE_SECONDS=600
REPAIR_RESULT_CACHE_SIZE=32
REPAIR_RESULT_TTL_SECONDS=3600

# Completed Ask results retained in process memory for the checks page.
RAG_RESULT_CACHE_SIZE=32
RAG_RESULT_TTL_SECONDS=3600
