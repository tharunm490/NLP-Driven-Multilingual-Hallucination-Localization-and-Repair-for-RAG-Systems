# ---------------------------------------------------------------------------
# This file documents all environment variables used by the project.
#
# Backend: copy backend/.env.example to backend/.env
# Frontend: copy frontend/.env.example to frontend/.env.local
#
# The variables below are the backend defaults. Never commit a real .env file.
# ---------------------------------------------------------------------------

# Application
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
FRONTEND_ORIGIN=http://localhost:3000
LOG_LEVEL=INFO

# Vector store (persistent local ChromaDB)
CHROMA_PERSIST_DIRECTORY=./data/chroma
CHROMA_COLLECTION_NAME=rag_documents
CHROMA_BATCH_SIZE=256

# Embeddings (only one model is loaded at a time)
EMBEDDING_MODEL_NAME=BAAI/bge-m3
EMBEDDING_DEVICE=auto
EMBEDDING_BATCH_SIZE=4
EMBEDDING_MAX_SEQ_LENGTH=1024
EMBEDDING_NORMALIZE=true
# "auto" applies model-specific prefixes (E5: "query: " / "passage: ").
# Set to an empty value (e.g. EMBEDDING_QUERY_PREFIX=) to disable prefixes.
EMBEDDING_QUERY_PREFIX=auto
EMBEDDING_PASSAGE_PREFIX=auto
EMBEDDING_TRUST_REMOTE_CODE=false
# Empty means "use EMBEDDING_MODEL_NAME" for token counting.
TOKENIZER_MODEL_NAME=

# Chunking (initial experimental values, not universal optima)
CHUNK_SIZE=700
CHUNK_OVERLAP=100

# Ingestion and retrieval
TOP_K=5
MAX_UPLOAD_SIZE_MB=20
MAX_FILES_PER_REQUEST=5
ALLOW_DUPLICATE_DOCUMENTS=false
LANGUAGE_DETECTION_ENABLED=true

# Storage paths (relative paths are resolved from backend/)
DATA_DIRECTORY=./data
DOCUMENT_REGISTRY_PATH=./data/document_registry.sqlite3

# Query language detection (Phase 3)
QUERY_LANGUAGE_MIN_CHARS=3
QUERY_LANGUAGE_MIN_CONFIDENCE=0.5
QUERY_LANGUAGE_MIN_MARGIN=0.15
QUERY_LANGUAGE_FALLBACK=

# RAG pipeline (Phase 3)
RAG_MAX_QUESTION_LENGTH=2000
RAG_MIN_EVIDENCE_CHUNKS=1
RAG_DISTANCE_FILTER_ENABLED=true
RAG_MAX_DISTANCE=0.75
RAG_GENERATION_WITHOUT_EVIDENCE=false

# Generative LLM (Phase 3). Groq/OpenAI/OpenRouter/Together are OpenAI-compatible.
# Set LLM_PROVIDER=mock for a network-free deterministic answer (tests/dev only).
# Never commit a real LLM_API_KEY.
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_TEMPERATURE=0
LLM_TIMEOUT_SECONDS=60
LLM_MAX_OUTPUT_TOKENS=800
